# === Application Settings ===
DB_HOST="db"
DB_PORT=3306
DB_NAME=resume
DB_USER=resume
DB_PASS=U4hE68Ka
APP_LOG_PATH=/var/log/resume/app.log
SQL_LOG_PATH=/var/log/resume/sql.log
APP_IP=0.0.0.0
APP_PORT=8080

# === Cors Settings ===
CORS_ALLOW_ORIGINS=http://localhost:5173,http://resume.local,http://www.resume.local,http://api.resume.local,http://agent.resume.local,http://corporate.resume.local
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization,X-Requested-With,X-Request-ID
CORS_EXPOSE_HEADERS=X-Request-ID
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE=12h

# === Firebase Authentication Settings ===
# Firebase プロジェクトID
FIREBASE_PROJECT_ID=your-project-id
# Firebase サービスアカウント鍵（JSON ファイル） /app/config/serviceAccountKey.json 等、絶対パスでもOK
FIREBASE_CREDENTIALS_FILE=/path/to/serviceAccountKey.json
# Auth Emulator 使用フラグ（dev 環境のみ）
FIREBASE_AUTH_EMULATOR=false
# Emulator のホスト設定（例: "localhost:9099"）
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
